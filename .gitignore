# Python virtual environments
.venv/
.venv]/
venv/

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# Source document corpus: keep originals locally, do not accidentally commit documents
/data/raw/**/*.[pP][dD][fF]
/data/raw/**/*.[hH][wW][pP]
/data/raw/**/*.[hH][wW][pP][xX]

# Environment variables and secrets
.env
.env.*
!.env.example

# Original policy documents
/data/raw/
/data/raw.zip

# Generated data/results
/data/parsed/*.json
/data/cleaned/*.json
/data/chunks/*.json
/metadata/documents.json
/metadata/sources.json
/metadata/document_relations.json
/reports/*.json

# OS / IDE
.DS_Store
.idea/
.vscode/

# HWP/HWPX conversion outputs, private working copies and journal
/data/converted/*
!/data/converted/.gitkeep
/metadata/conversions.json

# Generated embedding data
/data/embeddings/